NODE_ENV=development
DEVICEBRIDGE_HOST=127.0.0.1
DEVICEBRIDGE_PORT=8787
# Optional local hostname allowed by the Vite web console; keep machine-specific values in .env.
DEVICEBRIDGE_TAILNET_HOST=localhost
# Generate locally; never commit real value.
DEVICEBRIDGE_DEV_TOKEN=replace-with-long-random-value
DEVICEBRIDGE_DEVICE_ID=fedora-dev
DEVICEBRIDGE_PAIRING_TOKEN=replace-with-one-time-pairing-secret
DEVICEBRIDGE_PAIRING_TTL_SECONDS=600
# Unlock remains false until Phase 08 security validation.
DEVICEBRIDGE_ENABLE_UNLOCK=false
DEVICEBRIDGE_ENABLE_SCRCPY=false
# Optional local ADB serial; leave unset to let scrcpy select a single connected device.
# DEVICEBRIDGE_SCRCPY_SERIAL=
DEVICEBRIDGE_ENABLE_SUNSHINE_CONTROL=false
CODEX_GATEWAY_ENABLED=false
