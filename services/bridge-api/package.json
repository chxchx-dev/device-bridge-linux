{
  "name": "@devicebridge/bridge-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@devicebridge/command-registry": "workspace:*",
    "@devicebridge/codex-gateway": "workspace:*",
    "@devicebridge/contracts": "workspace:*",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
