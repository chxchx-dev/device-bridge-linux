[Unit]
Description=DeviceBridge local bridge API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/devicebridge
EnvironmentFile=%h/devicebridge/.env
Environment=DEVICEBRIDGE_ENABLE_MODES=true
Environment=DEVICEBRIDGE_CODEX_DB=%h/.local/state/devicebridge/codex.sqlite
Environment=DEVICEBRIDGE_STATE_DB=%h/.local/state/devicebridge/state.sqlite
ExecStart=/usr/bin/node %h/devicebridge/services/bridge-api/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
